# Copy this to .env.local and fill in the real values.
#
# Neither of these has the NEXT_PUBLIC_ prefix, and that is the whole point.
# Next.js only sends a variable to the browser when the name starts with
# NEXT_PUBLIC_, so these two stay on the server where the browser cannot read
# them.

# Where FastAPI is. localhost while developing, the Kubernetes service name
# once both are running in the cluster.
BACKEND_URL=http://127.0.0.1:8000

# The same key the backend checks for in the x-api-key header.
INTERNAL_API_KEY=replace-with-your-key
