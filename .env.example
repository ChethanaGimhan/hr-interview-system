# Copy this file to .env and fill in real values. .env is gitignored.

# Key that callers must send in the x-api-key header.
INTERNAL_API_KEY=pick-any-long-random-string

# Which LLM to use: gemini or claude
LLM_PROVIDER=gemini

# Gemini - free tier, get a key at https://aistudio.google.com/apikey (no card needed)
GEMINI_API_KEY=
# gemini-3.5-flash is the default. gemini-flash-lite-latest has a higher daily limit.
GEMINI_MODEL=gemini-3.5-flash

# Claude - only needed when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Only used by docker-compose, which starts its own Postgres. Kubernetes has
# its own password in a Secret and does not read this file.
POSTGRES_PASSWORD=pick-any-password
